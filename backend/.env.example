# App
APP_NAME=wardrobe-ai-shop
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=9000

# API
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg2://username:password@hostname:5432/dbname

# JWT / Auth
SECRET_KEY=change-me-generate-with-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60